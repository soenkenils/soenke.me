---
// Hidden easter egg: the Konami code (↑↑↓↓←→←→BA) opens "Baltic Turbo
// Challenge", a tiny canvas homage to Lotus Turbo Challenge 2 (Amiga, 1991).
// Only the trigger listener ships with the page — the game engine
// (src/scripts/racer-game.ts) is dynamic-imported on first unlock.
---

<dialog class="racer" id="racer" tabindex="-1" aria-label="Baltic Turbo Challenge — a small racing game">
  <div class="racer-frame">
    <canvas id="racerCanvas" width="640" height="360" aria-hidden="true"></canvas>
    <div class="racer-hud">
      <span>TIME <b id="rcTime">--</b></span>
      <span>SPEED <b id="rcSpeed">0</b></span>
      <span>DIST <b id="rcDist">0.00</b></span>
      <span>BEST <b id="rcBest">0.00</b></span>
    </div>
    <div class="racer-flash" id="racerFlash" hidden></div>
    <div class="racer-msg" id="racerMsg">
      <div>
        <span class="rm-title g-pink" id="rmTitle">BALTIC TURBO CHALLENGE</span>
        <span class="rm-sub" id="rmSub">an homage to lotus turbo challenge 2 · amiga 1991</span>
        <span class="g-cyan blink" id="rmAction">PRESS ENTER</span>
      </div>
    </div>
  </div>
  <div class="racer-under">
    <button class="racer-sound" id="racerSound" aria-pressed="false">♪ SOUND: OFF</button>
    <p class="racer-hint">← → steer · ↑ gas · ↓ brake · enter start · esc quit</p>
  </div>
  <button class="lb-btn lb-close" id="racerClose" aria-label="Close game">✕</button>
</dialog>

<script>
  /* Konami-code trigger — the game module loads only when unlocked */
  (function () {
    var dialog = document.getElementById('racer') as HTMLDialogElement | null;
    if (!dialog || typeof dialog.showModal !== 'function') return;
    var dlg = dialog;
    var rmAction = document.getElementById('rmAction')!;

    var SEQ = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    var WARM_AT = 4; //  ↑↑↓↓ — far enough in that no normal browsing hits it
    var step = 0;
    type Game = { open(autoStart?: boolean): void };
    var game: Game | null = null;
    var loading: Promise<Game> | null = null;
    var wantOpen = false;
    var queuedStart = false;

    /* Start fetching the engine chunk half-way through the code, so the
       remaining keystrokes cover the download instead of the user waiting
       on it. Idempotent; on failure the promise is dropped so the next
       attempt can retry. */
    function load() {
      if (!loading) {
        loading = import('../scripts/racer-game').then(function (m) {
          game = m.initRacer(dlg);
          return game;
        }, function (err) {
          loading = null;
          throw err;
        });
      }
      return loading;
    }

    function unlock() {
      wantOpen = true;
      queuedStart = false;
      /* the cabinet markup ships with the page — show it right away rather
         than sitting on a dead keypress until the chunk lands */
      if (!game) {
        rmAction.textContent = 'LOADING…';
        dlg.showModal();
        dlg.focus();
      }
      load().then(
        function (g) { if (wantOpen) g.open(queuedStart); },
        function () { if (wantOpen) rmAction.textContent = 'LOAD FAILED · ESC'; },
      );
    }

    document.addEventListener('keydown', function (e) {
      var k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      if (dlg.open) {
        /* engine not attached yet — hold on to an eager start keypress */
        if (!game && (k === 'Enter' || k === ' ')) queuedStart = true;
        return;
      }
      step = k === SEQ[step] ? step + 1 : k === SEQ[0] ? 1 : 0;
      if (step === WARM_AT) load().catch(function () { /* retried on unlock */ });
      if (step < SEQ.length) return;
      step = 0;
      unlock();
    });

    dialog.addEventListener('close', function () { wantOpen = false; });
    document.getElementById('racerClose')!.addEventListener('click', function () { dlg.close(); });
    /* click on the backdrop (event target is the dialog itself) closes */
    dialog.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });
  })();
</script>
